# From the repository root: mkdir -p local && cp integration/env.example local/test.env
# Then source local/test.env. See integration/README.md for disposable database setup.
# Both databases must be dedicated to tests: the suite changes Postgres state and recreates fixtures.

# Disposable Postgres test instance.
export DATABASE_URL="postgres://lightship:lightship@localhost:55433/lightship?sslmode=disable"

# Disposable ClickHouse test instance. Table names are fixed and guarded by the test suite.
export LIGHTSHIP_TEST_CLICKHOUSE="clickhouse://default@localhost:59000/otel"
