# Copy to .env and set CLICKHOUSE_DSN; everything else has a working default for evaluation.
# There is no config file — the access model lives in Postgres and is edited through the API,
# so the environment carries only deployment configuration and secrets.

# The one thing you must set: read-only credentials to your ClickHouse — the one you already
# run, holding your OTel traces. There is no default because this points at infrastructure
# only you have; leaving it unset stops the container at boot with a clear error.
#
# The URL scheme picks the wire protocol, and the wrong one fails the handshake rather than
# degrading: https:// is ClickHouse's HTTP interface (what ClickHouse Cloud exposes, port
# 8443), clickhouse:// is the native protocol (port 9000, or 9440 with TLS). For ClickHouse
# Cloud the shape is:
#   https://USER:PASSWORD@YOUR-INSTANCE.clickhouse.cloud:8443/DATABASE?secure=true
CLICKHOUSE_DSN=

# Postgres password for lightship's own state (access model, users, keys, audit — never trace
# data). The default works for evaluation, where Postgres is reachable only on the compose
# network. CHANGEME before deploying: the same value must reach both containers, so change it
# here, not in docker-compose.yml, and note that Postgres bakes the password into its data
# volume on first boot — changing it later means resetting the volume or ALTER ROLE.
POSTGRES_PASSWORD=lightship

# OPTIONAL. Set to manage the bootstrap admin credential yourself: generate a hash with
# `lightship hash` (or `docker compose run --rm control-plane hash`). When set, the
# environment wins on every boot — setting a new hash and restarting is how you rotate a
# leaked credential. Leave it empty and first boot generates a password and prints it to the
# container log exactly once (`docker compose logs control-plane`); restarts never reprint it.
LIGHTSHIP_ADMIN_PASSWORD_HASH=

# OPTIONAL. Listen address inside the container. The compose port mapping publishes container
# port 8080 to the host, so changing this without changing `ports:` in docker-compose.yml
# leaves the service running but unreachable from outside.
LIGHTSHIP_ADDR=:8080

# OPTIONAL. How long a replica may serve a cached access model, as a positive Go duration
# ("30s", "1m"). This is the window in which a policy change reaches every replica; role
# assignments are read per request and are immediate, and a single-replica deployment is
# immediate either way. A malformed or non-positive value stops the container at boot.
LIGHTSHIP_MODEL_TTL=1m

# OPTIONAL. Days of audit log to keep, as a positive integer; older rows are pruned
# in-process, so there is no cron to remember. Too low silently narrows the window you can
# answer "who queried what" over; a malformed or non-positive value stops the container at
# boot.
LIGHTSHIP_AUDIT_RETENTION_DAYS=90
